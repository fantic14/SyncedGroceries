# Copy to .env.local and restart Expo after changing values.
# These values ship in the app. Use a PUBLISHABLE key, never a secret/service-role key.
# For cloud APK builds, also set both in the Expo project's preview environment.
# See docs/ANDROID_TESTING_SETUP.md. No database password belongs here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
